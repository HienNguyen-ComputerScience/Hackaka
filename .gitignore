# DEPLOY BRANCH ONLY: data/ and relex-data-snapshot/ are committed here so Render can serve them.
# Everywhere else they stay ignored (see master's .gitignore). A deletion made on the deployed
# instance never reaches git: Render's disk is ephemeral and the app never commits.

# Supplied input corpus. Not our work; not ours to redistribute via this repo either.
/corpus/

# Any backup copy of a data store, wherever it's named or nested. (The judging snapshot itself is
# committed on this branch; other snapshot copies are not.)
*backup*/
*snapshot*/
!/relex-data-snapshot/
*_before/
*_before.*
*.bak

# Local attribution question set: names corpus people as expected proposers/agreers, so it must not
# enter history (a deleted person's name would persist in versioned source). test_full.py skips the
# A-rows when it is absent. Kept outside data/ so the deletion sweep and Part 3's restore ignore it.
/attribution_local.json

# Python / stray crash-dump housekeeping
__pycache__/
*.pyc
*.stackdump

# Local desktop-app launch config (machine-specific interpreter pin)
.claude/
